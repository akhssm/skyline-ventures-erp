   CONFIGURATION LISTS
   Grouped sections of lists, plus the read-only state for
   roles the server will not let write.
   --------------------------------------------------------- */

.config-section + .config-section {
  margin-top: 26px;
}

.config-hint {
  margin-top: 9px;
  font-size: 11.5px;
  line-height: 1.5;
  color: var(--text-subtle);
}

.page-summary .is-warning,
.page-summary .is-warning b {
  color: var(--warning);
  font-weight: 600;
}

/* The banner shown when the page is readable but not editable. */
.page-note {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 18px;
  padding: 11px 14px;
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  background: var(--surface-sunken);
  font-size: 12.5px;
  color: var(--text-muted);
}

.page-note svg {
  width: 14px;
  height: 14px;
  flex: none;
  color: var(--text-subtle);
}

/* A checkbox and its label on one line, inside a form field. */
.check-line {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  color: var(--text);
}

.check-line input:disabled + * {
  color: var(--text-subtle);
}

.tag-editor.is-readonly {
  background: var(--surface-sunken);
  border-style: dashed;
}

.tag-empty {
  font-size: 12px;
  color: var(--text-subtle);
}
