# Leave unset in development: Vite proxies /api to http://localhost:9000.
#
# In production point this at the deployed API. Either form works, because the
# client appends /api when it is missing:
#   https://skyline-erp-api.onrender.com
#   https://skyline-erp-api.onrender.com/api
#
# Vite inlines this at build time, so changing it needs a rebuild, not just a
# restart. On Render, saving the variable triggers that rebuild for you.
VITE_API_URL=
