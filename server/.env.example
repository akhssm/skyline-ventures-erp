# Local development. On Render these are set in the service's Environment tab
# and this file is never read.

PORT=9000
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas must allow the host's outbound IP. Render does not publish a fixed
# range on the free plan, so Network Access needs 0.0.0.0/0 there.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sellbill_erp?retryWrites=true&w=majority

# Use a long random value in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins. In production this is the
# front end's URL, for example https://skyline-erp-web.onrender.com
CLIENT_URL=http://localhost:5173

# demo returns the OTP in the API response; live requires a real SMS gateway
OTP_MODE=demo
DEMO_OTP=123456
