PORT=9000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sellbill_erp?retryWrites=true&w=majority

# Use a long random value in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# demo returns the OTP in the API response; live requires a real SMS gateway
OTP_MODE=demo
DEMO_OTP=123456
